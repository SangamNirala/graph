# 🔑 API Keys Template for Nutrition App
# Copy this file to backend/.env and fill in your actual API keys

# =================================
# FOOD & NUTRITION APIs (FREE TIERS)
# =================================

# USDA Food Data Central API
# Get your free key at: https://api.data.gov/signup/
# Free tier: 1,000 requests per hour
USDA_API_KEY=DEMO_KEY

# Spoonacular Food API  
# Get your free key at: https://spoonacular.com/food-api
# Free tier: 150 requests per day
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Edamam Nutrition API
# Get your free keys at: https://developer.edamam.com/
# Free tier: 5 requests per minute
EDAMAM_APP_ID=your_edamam_app_id_here
EDAMAM_APP_KEY=your_edamam_app_key_here

# =================================
# AI & MACHINE LEARNING (FREE TIERS)
# =================================

# Google Gemini AI (Free)
# Get your API key at: https://makersuite.google.com/app/apikey
# Free tier: 15 requests per minute
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face (Free)
# Get your token at: https://huggingface.co/settings/tokens
# Free tier: Unlimited inference API calls
HUGGINGFACE_TOKEN=your_huggingface_token_here

# =================================
# DATABASE & STORAGE (FREE TIERS)
# =================================

# MongoDB Connection (Keep existing)
MONGO_URL=mongodb://localhost:27017
DB_NAME=nutrition_app

# =================================
# OPTIONAL ENHANCED FEATURES
# =================================

# Open Food Facts API (No key required, but recommended for production)
# Register at: https://world.openfoodfacts.org/
OPENFOODFACTS_USER_AGENT=NutritionApp/1.0 (your-email@example.com)

# Calories Ninja API (Free alternative)
# Get your key at: https://api.calorieninjas.com/
CALORIES_NINJA_API_KEY=your_calories_ninja_key_here

# =================================
# PRODUCTION CONFIGURATION
# =================================

# Environment
NODE_ENV=development

# Rate limiting
API_RATE_LIMIT=100

# Cache duration (in seconds)
CACHE_DURATION=3600

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=10

# =================================
# INSTRUCTIONS
# =================================

# 1. Copy this file to backend/.env
# 2. Replace "your_*_key_here" with actual API keys
# 3. Keep DEMO_KEY for testing USDA API initially
# 4. Restart the backend server after adding keys
# 5. Check rate limits to stay within free tiers

# Free Tier Summary:
# - USDA: 1,000 req/hour (sufficient for development)
# - Spoonacular: 150 req/day (use caching for efficiency) 
# - Edamam: 5 req/min (best for nutrition analysis)
# - Gemini: 15 req/min (perfect for AI features)
# - MongoDB Atlas: 512MB free (upgrade when needed)

# Pro Tips:
# - Cache API responses to reduce calls
# - Use DEMO_KEY initially for USDA testing
# - Implement fallback for when API limits are reached
# - Consider batch processing for efficiency